{
  "name": "dsh-git-commit",
  "version": "0.1.1",
  "type": "module",
  "description": "Floating Git stats and AI commits with native DSH LLM, authenticated RPC, settings and shared service",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js && node --test test/*.test.js"
  },
  "dependencies": {
    "@mcarvin/smart-diff": "^6.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBobbyTS/dsh-git-commit.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "git",
    "commit",
    "ai",
    "plugin"
  ],
  "types": "lib/index.d.ts"
}
